# Copy to .env.local (dev) or set in the build environment. All are optional on the devnet: without VITE_MINE the
# app reads ../deployments/devnet.json (or HMM_DEPLOYMENT=path/to/deployment.json).

# Chain the app talks to (1 = Ethereum mainnet).
VITE_CHAIN_ID=1
# Read-only RPC used when no wallet is connected (and for event indexing). Use your own node or a provider you trust.
VITE_RPC_URL=https://ethereum-rpc.publicnode.com
# hmm contracts (unknown until launch).
VITE_HMM=
VITE_MINE=
VITE_ADAPTER=
# Block the mine was deployed in: the event indexer starts here.
VITE_DEPLOY_BLOCK=
# IMD and the IMD Intake (defaults are the mainnet addresses).
VITE_IMD=0xD34a99Bc0f67aE1bbd63C660e6d0b0dd03E263B7
VITE_INTAKE=0xa43e6f75ee006411f79ac1c84120606c2330de82
# Block explorer for links (empty = none).
VITE_EXPLORER=https://etherscan.io
# Question checker proxy (see proxy/check-worker.js). Empty disables the check; `vite dev` defaults to /imd-check.
VITE_CHECK_URL=
# Max blocks per eth_getLogs call (the indexer halves it on errors).
VITE_LOG_CHUNK=20000
